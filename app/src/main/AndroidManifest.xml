<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Faz 3C: the app needs no internet. Play Billing 9.1.0 declares only
         com.android.vending.BILLING and talks to the Play Store app on the
         device; the cloud Assistant was cancelled. The bundled ML Kit models
         pull a diagnostics uploader (datatransport) that declares INTERNET:
         removed here, so no usage data can leave the phone. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />

    <!-- WorkManager (daily Trash purge) declares a foreground service. Smart
         Cleaner never runs a long-running Worker/foreground service, so remove
         that generic foreground-service surface from the merged manifest. -->
    <!-- Faz 3A-2: shrinking videos runs in a foreground service the user starts
         with a tap; mediaProcessing on Android 15+, dataSync on Android 11–14. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Faz 3A-1 Storage Watch notices; asked only when the user turns the watch on. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".DepoAkilliApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DepoAkilli">

        <!-- Faz 3B-2: Google Play services keeps the face and label models on the phone (not in the app). -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="face,ica" />

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            tools:node="remove" />

        <service
            android:name=".video.VideoCompressionService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProcessing" />

        <activity
            android:name=".MainActivity"
            android:enableOnBackInvokedCallback="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
