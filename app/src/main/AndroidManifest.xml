<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Faz 3C: the app needs no internet. Play Billing 9.1.0 declares only
         com.android.vending.BILLING and talks to the Play Store app on the
         device; the cloud Assistant was cancelled. ML Kit (models from Google
         Play services), MediaPipe and Play Billing bring Google's usage-log
         uploader (datatransport) that declares INTERNET: removed here, and its
         only sender (the CCT backend) is unregistered below, so it never tries
         the network (Fable review). -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />

    <!-- WorkManager (daily Trash purge) declares a foreground service. Smart
         Cleaner never runs a long-running Worker/foreground service, so remove
         that generic foreground-service surface from the merged manifest. -->
    <!-- Faz 3A-2: shrinking videos runs in a foreground service the user starts
         with a tap; mediaProcessing on Android 15+, dataSync on Android 11–14. -->
    <!-- Faz 3A-1 Storage Watch notices; asked only when the user turns the watch on. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".DepoAkilliApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DepoAkilli">

        <!-- Fable review: no uploader for Google's usage logs. Without a registered
             backend, datatransport drops its log batches instead of opening a
             connection (which, without INTERNET, could throw). Its scheduler
             components stay: they are only used to run that cleanup. -->
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            tools:node="merge">
            <meta-data
                android:name="backend:com.google.android.datatransport.cct.CctBackendFactory"
                tools:node="remove" />
        </service>

        <!-- Faz 3B-2: Google Play services keeps the face and label models on the phone (not in the app). -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="face,ica" />

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            tools:node="remove" />


        <activity
            android:name=".MainActivity"
            android:enableOnBackInvokedCallback="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
